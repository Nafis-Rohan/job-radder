// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  DEMO
}

enum Level {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  UNKNOWN
}

enum RemoteEligibility {
  ELIGIBLE
  NOT_ELIGIBLE
  UNKNOWN
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  role           Role      @default(USER)
  totpSecretEnc  String?
  totpEnabled    Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  telegramChatId String?
  alertThreshold Int       @default(50)
  createdAt      DateTime  @default(now())
  cvs            Cv[]
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Cv {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  textEnc   String
  skills    String[]
  keywords  String[]
  yearsExp  Float
  level     Level
  domains   String[]
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Jobs are shared by all users. One row per real job (hash = company + title + location).
model Job {
  id             String             @id @default(cuid())
  source         String
  url            String             @unique
  hash           String             @unique
  title          String
  company        String
  location       String?
  description    String?
  deadline       DateTime?
  experienceText String?
  minYears       Float?
  maxYears       Float?
  skills         String[]
  level          Level              @default(UNKNOWN)
  domains        String[]
  postedAt       DateTime?
  foundAt        DateTime           @default(now())
  isRemote       Boolean            @default(false)
  remoteScope    String?
  eligibility    RemoteEligibility?

  @@index([foundAt])
  @@index([company])
  @@index([isRemote, eligibility])
}
