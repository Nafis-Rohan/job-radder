// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  DEMO
}

enum Level {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  UNKNOWN
}

enum RemoteEligibility {
  ELIGIBLE
  NOT_ELIGIBLE
  UNKNOWN
}

enum MatchLabel {
  STRONG
  GOOD
  PARTIAL
  WEAK
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

model User {
  id             String            @id @default(cuid())
  username       String            @unique
  passwordHash   String
  role           Role              @default(USER)
  totpSecretEnc  String?
  totpEnabled    Boolean           @default(false)
  failedLogins   Int               @default(0)
  lockedUntil    DateTime?
  telegramChatId String?
  alertThreshold Int               @default(50)
  createdAt      DateTime          @default(now())
  cvs            Cv[]
  favorites      FavoriteCompany[]
  favoriteAlerts FavoriteAlert[]
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Cv {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  textEnc   String
  skills    String[]
  keywords  String[]
  yearsExp  Float
  level     Level
  domains   String[]
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  matches   Match[]

  @@index([userId])
}

// Jobs are shared by all users. One row per real job (hash = company + title + location).
model Job {
  id             String             @id @default(cuid())
  source         String
  url            String             @unique
  hash           String             @unique
  title          String
  company        String
  location       String?
  description    String?
  deadline       DateTime?
  experienceText String?
  minYears       Float?
  maxYears       Float?
  skills         String[]
  level          Level              @default(UNKNOWN)
  domains        String[]
  postedAt       DateTime?
  foundAt        DateTime           @default(now())
  isRemote       Boolean            @default(false)
  remoteScope    String?
  eligibility    RemoteEligibility?
  matches        Match[]
  favoriteAlerts FavoriteAlert[]

  @@index([foundAt])
  @@index([company])
  @@index([isRemote, eligibility])
}

// How well one job fits one CV. Saved only when total >= 40, so weak matches do not fill the free database.
// Deleting a job or a CV deletes its matches too (onDelete: Cascade).
model Match {
  id        String     @id @default(cuid())
  cvId      String
  cv        Cv         @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stackFit  Int? // null when the job lists no skills
  expFit    Int
  levelFit  Int
  domainFit Int
  total     Int
  label     MatchLabel
  gaps      String[] // skills the job asks for and the CV does not have
  notified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([cvId, jobId])
  @@index([cvId, total]) // the job list: one CV, best matches first
  @@index([jobId]) // lets "delete old jobs" find their matches fast
}

// One row per scan. A RUNNING row younger than 30 minutes is the lock that stops two scans at once.
model ScanRun {
  id         String    @id @default(cuid())
  trigger    String // "cron" | "manual" | "local"
  status     RunStatus
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  perSource  Json? // { "weworkremotely": { found, inserted, duplicates, invalid, skipped, error? } }
  newJobs    Int       @default(0)
  alertsSent Int       @default(0)

  @@index([startedAt])
}

// A company the user wants to watch. The user must give its career page: the scraper reads the jobs from there.
// Jobs stay shared by all users; "is this job from a favorite" is worked out when the list is read.
model FavoriteCompany {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  aliases    String[] // other spellings of the name, e.g. "GP" for "Grameenphone"
  careersUrl String // https career page, e.g. https://vivasoftltd.com/career/
  createdAt  DateTime @default(now())

  @@unique([userId, name])
}

// "Telegram alert sent": one row per (user, job) of a favorite company, so the same job is never alerted twice.
// Separate from Match.notified on purpose: a favorite's job may have no Match row (no CV yet).
// Deleting the job or the user deletes its rows too.
model FavoriteAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([jobId]) // lets "delete old jobs" find their alerts fast
}
